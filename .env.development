# Overrides for `vite` / `vite build --mode development`.
# `VITE_ENGAGE_API_HOST` may be left empty: vite.config.js falls back to the root `.env` file for local dev.
# CI: set `VITE_ENGAGE_API_HOST` (or `VITE_ENGAGE_API_HOST_DEV`) in the job env — process env wins first.

VITE_APP_NAME=Clarus Engage
VITE_APP_ENV=development

VITE_ENGAGE_API_HOST=https://jsonplaceholder.typicode.com
