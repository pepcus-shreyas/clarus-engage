# Local development defaults (copy from .env.example; this file is gitignored).
# Vite exposes only variables prefixed with VITE_ to client code.
# `.env.development` must not redefine `VITE_ENGAGE_API_HOST` empty, or it overrides this file.

VITE_APP_NAME=Clarus Engage
VITE_APP_ENV=development

# Main Engage API origin (no trailing slash)
VITE_ENGAGE_API_HOST=https://jsonplaceholder.typicode.com
